<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_default">

    <TextView
        android:id="@+id/tvFechaAtencion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvMedicoAtencion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp" />

    <TextView
        android:id="@+id/tvFactoresRiesgo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Factores de riesgo: Sin registrar" />

    <TextView
        android:id="@+id/tvAnamnesis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp" />

    <TextView
        android:id="@+id/tvDiagnostico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp" />

    <TextView
        android:id="@+id/tvObservaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp" />

    <TextView
        android:id="@+id/tvSignosVitales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Signos vitales: Sin registrar" />

    <TextView
        android:id="@+id/tvPrescripciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Prescripciones: Sin registrar" />

    <TextView
        android:id="@+id/tvEstudios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Estudios solicitados: Sin registrar" />

</LinearLayout>
