<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/containerFila"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Nombre Completo (Alineado a la izquierda) -->
    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.2"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:singleLine="true"
        android:text="Sofía Valentina Ma..."
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- DNI (Centrado) -->
    <TextView
        android:id="@+id/tvDni"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:gravity="center"
        android:text="38.241.902"
        android:textColor="#475569"
        android:textSize="13sp" />

    <!-- Teléfono (Centrado) -->
    <TextView
        android:id="@+id/tvTelefono"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:gravity="center"
        android:text="+54 9 11 4059-1921"
        android:textColor="#475569"
        android:textSize="13sp" />

    <!-- Obra Social (Centrado) -->
    <TextView
        android:id="@+id/tvObraSocial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="OSDE"
        android:textColor="#475569"
        android:textSize="13sp" />

    <!-- Último Turno (Centrado) -->
    <TextView
        android:id="@+id/tvUltimoTurno"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:gravity="center"
        android:text="23 Oct 2024"
        android:textColor="#475569"
        android:textSize="13sp" />

    <!-- Badge Estado (Centrado) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:gravity="center">

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_confirmado"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="CONFIRMADO"
            android:textColor="#166534"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botón Ver Ficha (Centrado) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnFicha"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Ver Ficha"
            android:src="@android:drawable/ic_menu_add" />
    </LinearLayout>

</LinearLayout>