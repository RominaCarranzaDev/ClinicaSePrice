<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".ConsultoriosPacientesActivity">

    <!-- BARRA DE FILTROS (SPINNERS COMPACTOS + BOTÓN) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Spinner Estado -->
        <Spinner
            android:id="@+id/spEstado"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_spinner"
            android:entries="@array/array_estados"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- Spinner Obra Social -->
        <Spinner
            android:id="@+id/spObraSocial"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_spinner"
            android:entries="@array/array_obras_sociales"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- Espaciador flexible -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Botón Nuevo Paciente -->
        <Button
            android:id="@+id/btnNuevoPaciente"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/primary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="+ Nuevo Paciente"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- TARJETA TABLA DE PACIENTES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_table"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- ENCABEZADOS DE COLUMNA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Nombre Completo (Alineado a la izquierda) -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2.2"
                android:gravity="start|center_vertical"
                android:text="Nombre Completo"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- DNI (Centrado) -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:gravity="center"
                android:text="DNI"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Teléfono (Centrado) -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:gravity="center"
                android:text="Teléfono"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Obra Social (Centrado) -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:gravity="center"
                android:text="Obra Social"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Último Turno (Centrado) -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:text="Último Turno"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Estado (Centrado) -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:gravity="center"
                android:text="Estado"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Ficha (Centrado) -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:gravity="center"
                android:text="Ficha"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0" />

        <!-- Listado RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPacientes"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</LinearLayout>