<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ficha médica del paciente"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDatosPacienteFicha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E0F2FE"
            android:padding="14dp"
            android:textColor="#1E293B"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Antecedentes médicos"
            android:textColor="#334155"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAntecedentes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Antecedentes del paciente"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Alergias"
            android:textColor="#334155"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAlergias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Alergias conocidas"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Medicación actual"
            android:textColor="#334155"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMedicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Medicación informada"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Observaciones"
            android:textColor="#334155"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etObservaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Observaciones médicas"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <Button
            android:id="@+id/btnGuardarFicha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Guardar ficha médica"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
