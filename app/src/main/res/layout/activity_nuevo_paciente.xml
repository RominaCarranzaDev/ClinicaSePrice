<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".NuevoPacienteActivity">

    <!-- TARJETA FORMULARIO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_table"
        android:elevation="1dp"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Nuevo Paciente"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Complete los datos personales e institucionales para dar de alta la ficha médica."
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- FILA 1: Nombre Completo y DNI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <!-- Nombre Completo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Nombre Completo *"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNuevoNombre"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_search_input"
                    android:hint="Ej: María Laura Gómez"
                    android:inputType="textCapWords"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- DNI -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="DNI / Documento *"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNuevoDni"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_search_input"
                    android:hint="Sin puntos (ej: 35123456)"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- FILA 2: Teléfono y Obra Social -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:orientation="horizontal">

            <!-- Teléfono -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Teléfono *"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNuevoTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_search_input"
                    android:hint="+54 9 11 ..."
                    android:inputType="phone"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Obra Social -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Obra Social *"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spNuevoObraSocial"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_spinner"
                    android:entries="@array/array_obras_sociales_registro"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- BOTONES DE ACCIÓN (Alineados a la derecha) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelarPaciente"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:backgroundTint="#F1F5F9"
                android:paddingHorizontal="24dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="#475569"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnGuardarPaciente"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="@color/primary"
                android:paddingHorizontal="24dp"
                android:text="Guardar Paciente"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>