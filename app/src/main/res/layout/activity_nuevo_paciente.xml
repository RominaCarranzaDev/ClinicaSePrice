<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true"
    tools:context=".NuevoPacienteActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_table"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrar Nuevo Paciente"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Complete los datos personales y de cobertura del paciente."
                android:textColor="#64748B"
                android:textSize="13sp" />

            <!-- NOMBRE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Nombre *"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNuevoNombre"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_search_input"
                android:hint="Nombre del paciente"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textSize="13sp" />

            <!-- APELLIDO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Apellido *"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNuevoApellido"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_search_input"
                android:hint="Apellido del paciente"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textSize="13sp" />

            <!-- DNI -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="DNI *"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNuevoDni"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_search_input"
                android:hint="Sin puntos (ej.: 35123456)"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textSize="13sp" />

            <!-- FECHA DE NACIMIENTO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Fecha de nacimiento"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNuevoFechaNacimiento"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_search_input"
                android:hint="DD/MM/AAAA"
                android:inputType="date"
                android:paddingHorizontal="12dp"
                android:textSize="13sp" />

            <!-- TELEFONO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Teléfono *"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNuevoTelefono"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_search_input"
                android:hint="+54 9 11..."
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:textSize="13sp" />

            <!-- DOMICILIO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Domicilio"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNuevoDomicilio"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_search_input"
                android:hint="Calle y número"
                android:inputType="textPostalAddress|textCapSentences"
                android:paddingHorizontal="12dp"
                android:textSize="13sp" />

            <!-- EMAIL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="E-mail"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNuevoEmail"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_search_input"
                android:hint="correo@ejemplo.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="12dp"
                android:textSize="13sp" />

            <!-- OBRA SOCIAL / PARTICULAR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Obra Social / Particular *"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spNuevoObraSocial"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_spinner"
                android:entries="@array/array_obras_sociales_registro"
                android:paddingHorizontal="8dp" />

            <!-- NUMERO DE AFILIADO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Número de afiliado"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNuevoNumeroObraSocial"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_search_input"
                android:hint="Ingresar si corresponde"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Si el paciente es Particular, no necesita número de afiliado."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <!-- BOTONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelarPaciente"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="12dp"
                    android:backgroundTint="#F1F5F9"
                    android:paddingHorizontal="20dp"
                    android:text="Cancelar"
                    android:textAllCaps="false"
                    android:textColor="#475569"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnGuardarPaciente"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:backgroundTint="@color/primary"
                    android:paddingHorizontal="20dp"
                    android:text="Guardar Paciente"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
