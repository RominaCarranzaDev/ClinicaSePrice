<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardTurno"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="4dp"
    android:background="@drawable/bg_item_turno"
    android:clickable="true"
    android:focusable="true"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvPacienteTurno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre del paciente"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1E3A8A" />

    <TextView
        android:id="@+id/tvDetallesTurno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Detalles del turno"
        android:textSize="14sp"
        android:textColor="#334155" />

    <Button
        android:id="@+id/btnAcreditarTurno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Acreditar y enviar a sala de espera"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2E7D32" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnModificarTurno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Modificar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2" />

        <Button
            android:id="@+id/btnCancelarTurno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Cancelar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2" />

    </LinearLayout>

</LinearLayout>
