<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ButtonPrimary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="background">@drawable/bg_button_primary</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/primary</item>

        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/spacing_m</item>
        <item name="android:paddingVertical">@dimen/spacing_s</item>

    </style>

    <style name="ButtonSecondary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="background">@drawable/bg_button_secondary</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:backgroundTint">@color/white</item>

        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/spacing_m</item>
        <item name="android:paddingVertical">@dimen/spacing_s</item>

    </style>

    <style name="CardDefault">
        <item name="background">@drawable/bg_card_default</item>
        <item name="android:elevation">@dimen/elevation_s</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CardActive">
        <item name="background">@drawable/bg_card_active</item>
        <item name="android:elevation">@dimen/elevation_m</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CardPrimary">
        <item name="background">@drawable/bg_card_primary</item>
        <item name="android:elevation">@dimen/elevation_s</item>
        <item name="android:textColor">@color/secondary</item>
    </style>

    <style name="Title">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Subtitle">
        <item name="android:textColor">@color/shadow</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="textAllCaps">true</item>
    </style>
</resources>